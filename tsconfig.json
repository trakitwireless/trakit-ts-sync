{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": true,
		"declarationDir": "./_publish",
		"emitDeclarationOnly": false,
		"rootDir": "./sync",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"outDir": "./_publish", // Output directory
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitUseStrict": false,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"paths": {
			"@trakit/commands": [
				"../trakit-ts-commands/_publish/index.d.ts",
				//"../trakit-ts-commands/commands/index.ts",
			],
			"@trakit/objects": [
				"../trakit-ts-objects/_publish/index.d.ts",
				//"../trakit-ts-objects/objects/index.ts",
			]
		},
	},
	"include": [
		"./sync/index.ts"
	]
}