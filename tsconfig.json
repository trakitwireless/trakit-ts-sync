{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "outDir": "_publish",
        "composite": true,
        "sourceMap": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noImplicitUseStrict": false,
        "strictNullChecks": true,
        "baseUrl": ".",
        "paths": {
            "@commands/*": ["../trakit-ts-commands/commands/*"],
            '@trakit/objects';: ["../trakit-ts-objects/objects/*"],
        }
    },
    "references": [
        { "path": "../trakit-ts-commands" },
        { "path": "../trakit-ts-objects" }
    ]
}